    "type": "real",
    "buildings_file": "data/scenes/airport_sjc/airport_sjc_buildings.geojson",
    "sensor_locations_file": "data/scenes/airport_sjc/airport_sjc_sensors.geojson",
    "resolution": 40.0,
    "bounds_expansion": 300
  },
  "airway_altitudes": [
    20,
    45,
    65
  ],
  "sensors": {
    "types": {
      "Radar": {
        "cost": 50000.0,
        "power_W": 1000.0,
        "gain_dB": 30.0,
        "frequency_Hz": 10000000000.0,
        "elevation_min": -5.0,
        "elevation_max": 30.0,
        "max_range": 3000.0,
        "fov_horizontal": 360.0
      },
      "RF": {
        "cost": 15000.0,
        "sensitivity_dBm": -90.0,
        "frequency_Hz": 900000000.0,
        "elevation_min": -30.0,
        "elevation_max": 70.0,
        "fov_horizontal": 360.0
      },
      "EO": {
        "cost": 25000.0,
        "elevation_min": -20.0,
        "elevation_max": 45.0,
        "fov_horizontal": 360.0,
        "max_range": 150.0
      },
      "Acoustic": {
        "cost": 8000.0,
        "source_spl_dB": 80.0,
        "snr_threshold_dB": 6.0,
        "max_range": 300.0,
        "elevation_min": -20.0,
        "elevation_max": 70.0,
        "fov_horizontal": 360.0
      }
    }
  },
  "optimization": {
    "objectives": "dual_layer"
