{
  "experiment_name": "paper_rerun_paulista_lite",
  "description": "Paper redo — Avenida Paulista lite (higher voxel, smaller GA) for feasible cloud rerun of the real-city case.",
  "environment": {
    "type": "real",
    "buildings_file": "data/case_studies/avenida_paulista/avenida_paulista_buildings.geojson",
    "sensor_locations_file": "data/case_studies/avenida_paulista/avenida_paulista_sensors.geojson",
    "resolution": 40.0
  },
  "airway_altitudes": [20, 45, 65],
  "sensors": {
    "types": {
      "Radar": {
        "cost": 50000.0,
        "power_W": 1000.0,
        "gain_dB": 30.0,
        "frequency_Hz": 10000000000.0,
        "elevation_min": -5.0,
        "elevation_max": 30.0,
        "fov_horizontal": 360.0,
        "max_range": 2000.0
      },
      "RF": {
        "cost": 15000.0,
        "sensitivity_dBm": -90.0,
        "frequency_Hz": 900000000.0,
        "elevation_min": -30.0,
        "elevation_max": 70.0,
        "fov_horizontal": 360.0
      },
      "EO": {
        "cost": 25000.0,
        "elevation_min": -20.0,
        "elevation_max": 45.0,
        "fov_horizontal": 360.0,
        "max_range": 150.0
      },
      "Acoustic": {
        "cost": 8000.0,
        "source_spl_dB": 80.0,
        "snr_threshold_dB": 6.0,
        "max_range": 300.0,
        "elevation_min": -20.0,
        "elevation_max": 70.0,
        "fov_horizontal": 360.0
      }
    }
  },
  "optimization": {
    "objectives": "dual_layer"
  },
  "pareto_search": {
    "n_samples": 24,
    "generations": 10,
    "n_cores": 4,
    "min_sensors": 5,
    "max_sensors": 18
  },
  "site_activation_cost": 15000,
  "critical_assets": [
    {
      "id": "MASP",
      "location": [500, 500, 40],
      "protection_radius": 150,
      "weight_multiplier": 1.0
    },
    {
      "id": "Hospital_Albert_Einstein_proxy",
      "location": [300, 700, 35],
      "protection_radius": 120,
      "weight_multiplier": 0.95
    }
  ],
  "requirements": {
    "min_M_wp_coop": 0.85,
    "min_M_wp_noncoop": 0.30,
    "min_coverage": 0.70,
    "min_overlap": 0.30
  },
  "output": {
    "results_dir": "results/paper_rerun_paulista_lite",
    "run_id": "run_lite",
    "save_results": true,
    "generate_plots": true
  },
  "analysis": {
    "max_solutions": 30
  },
  "checkpoint": {
    "enabled": true,
    "dir": "checkpoints/paper_rerun_paulista_lite",
    "frequency": 3,
    "resume": true
  }
}
