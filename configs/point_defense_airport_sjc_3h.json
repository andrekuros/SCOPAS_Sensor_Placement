  "runways_protection_radius": 80,
  "runways_exclusion_margin": 50,
  "runways_display_offset": [30, -80],
  "critical_assets": [
    {
      "id": "Airport_Terminal_SJC",
      "location": [555, 568, 30],
      "protection_radius": 180,
      "weight_multiplier": 1.0
    }
  ],
  "requirements": { "min_coverage": 0.7, "min_overlap": 0.35 },
  "output": {
    "results_dir": "results/point_defense_airport_sjc",
    "run_id": "airport_run_3h",
    "save_results": true,
    "generate_plots": true
  },
  "analysis": { "max_solutions": 25 }
}
