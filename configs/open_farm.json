{
  "experiment_name": "open_farm",
  "description": "Open farm: few buildings (2 sheds), large area 2km x 2km, dense sensor grid",
  "environment": {
    "type": "synthetic",
    "buildings_file": "data/scenes/open_farm/buildings.geojson",
    "sensor_locations_file": "data/scenes/open_farm/sensor_locations.geojson",
    "resolution": 25.0
  },
  "airway_altitudes": [20, 45, 65],
  "sensors": {
    "types": {
      "Radar": { "cost": 50000.0, "power_W": 1000.0, "gain_dB": 30.0, "frequency_Hz": 1e10 },
      "RF": { "cost": 15000.0, "sensitivity_dBm": -90.0, "frequency_Hz": 900e6 },
      "EO": { "cost": 25000.0 }
    }
  },
  "pareto_search": {
    "n_samples": 30,
    "generations": 20,
    "n_cores": 4,
    "min_sensors": 3,
    "max_sensors": 20
  },
  "requirements": { "min_coverage": 0.70, "min_overlap": 0.30 },
  "output": { "results_dir": "results/open_farm", "save_results": true, "generate_plots": true }
}
