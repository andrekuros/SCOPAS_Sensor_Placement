{
  "experiment_name": "open_farm",
  "description": "Open farm: few buildings (2 sheds), large area 2km x 2km, dense sensor grid",
  "environment": {
    "type": "synthetic",
    "buildings_file": "data/scenes/open_farm/buildings.geojson",
    "sensor_locations_file": "data/scenes/open_farm/sensor_locations.geojson",
    "resolution": 25.0
  },
  "airway_altitudes": [
    20,
    45,
    65
  ],
  "sensors": {
    "types": {
      "Radar": {
        "cost": 50000.0,
        "power_W": 1000.0,
        "gain_dB": 30.0,
        "frequency_Hz": 10000000000.0
      },
      "RF": {
        "cost": 15000.0,
        "sensitivity_dBm": -90.0,
        "frequency_Hz": 900000000.0
      },
      "EO": {
        "cost": 25000.0
      },
      "Acoustic": {
        "cost": 8000.0,
        "source_spl_dB": 80.0,
        "snr_threshold_dB": 6.0,
        "max_range": 300.0,
        "elevation_min": -20.0,
        "elevation_max": 70.0,
        "fov_horizontal": 360.0
      }
    }
  },
  "pareto_search": {
    "n_samples": 30,
    "generations": 20,
    "n_cores": 4,
    "min_sensors": 3,
    "max_sensors": 20
  },
  "requirements": {
    "min_coverage": 0.7,
    "min_overlap": 0.3
  },
  "output": {
    "results_dir": "results/open_farm",
    "save_results": true,
    "generate_plots": true
  }
}
